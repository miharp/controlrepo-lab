# Appended to data/nodes/matrix01.voxpupu.li.yaml in the server's copy only.
# lab.sh renders this once into overrides/matrix01.voxpupu.li.yaml
# (gitignored) with names from lab.env and random secrets; edit that file
# afterwards, for example to put a real bucket in.

# The lab's own names. Never the production ones: this server is public.
profiles::matrix::server_name: '@SERVER_NAME@'
profiles::matrix::matrix_domain: '@MATRIX_DOMAIN@'

profiles::matrix::sensitive_postgres_password: '@RANDOM@'
profiles::matrix::sensitive_macaroon_secret_key: '@RANDOM@'
profiles::matrix::sensitive_form_secret: '@RANDOM@'
profiles::matrix::sensitive_registration_shared_secret: '@RANDOM@'

# Dummies: Synapse runs, uploads stay local and the S3 sync fails. For a
# real media test, create a Hetzner Object Storage bucket and put its
# name, region, endpoint and keys here.
profiles::matrix::sensitive_s3_access_key: 'LABDUMMYACCESSKEY'
profiles::matrix::sensitive_s3_secret_key: 'lab-dummy-secret-key'
profiles::matrix::s3_bucket: 'lab-media'
profiles::matrix::s3_region: 'lab'
profiles::matrix::s3_endpoint: 'https://s3.lab.invalid'

# No borg server to reach from a lab.
profiles::base::manage_borg: false
