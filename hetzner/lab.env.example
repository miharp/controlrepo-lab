# Copy to lab.env (gitignored) and fill in. lab.sh sources it.

# Hetzner Cloud API token (read/write) for the project the lab lives in.
HCLOUD_TOKEN=

# Two DNS names you control, under a subdomain used for nothing else.
# SERVER_NAME is the Matrix identity (@user:SERVER_NAME); MATRIX_DOMAIN is
# where Synapse answers. Both need to resolve to the lab's address.
#
# Other homeservers remember a server name, its key and its room
# memberships. Give every fresh database a new pair (r1, r2, ...) instead
# of reusing one that has federated; a new pair also gets new
# certificates without touching Let's Encrypt's duplicate limit.
#
# With one wildcard record, *.LAB_WILDCARD_PARENT, every pair resolves
# and DNS is set up once.
#   LAB_WILDCARD_PARENT=lab.example.org
#   LAB_SERVER_NAME=r1.lab.example.org
#   LAB_MATRIX_DOMAIN=matrix.r1.lab.example.org
LAB_WILDCARD_PARENT=
LAB_SERVER_NAME=
LAB_MATRIX_DOMAIN=

# Contact address for the lab's Let's Encrypt account.
LAB_ACME_EMAIL=

# Optional.
#LAB_LOCATION=nbg1
#LAB_SERVER_TYPE=cx33
#LAB_SSH_PUBKEY=~/.ssh/id_ed25519.pub
#LAB_CONTROLREPO=../../voxpupuli_controlrepo
